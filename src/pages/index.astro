---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { site, links, profiles, MODES } from '../config';
import { projects } from '../data/projects';
import { getPosts, url, readingTime, formatDate } from '../lib/utils';

const posts = await getPosts();
const HOME_LIMIT = 6;
const pro = profiles.professional;
const per = profiles.personal;
---

<Base>
  <!-- ── Hero ─────────────────────────────────────────── -->
  <section class="hero">
    <div class="intro">
      <p class="eyebrow" data-show="professional" data-fade>
        <span class="pulse" aria-hidden="true"></span>{pro.tagline}
      </p>
      <p class="eyebrow" data-show="personal" data-fade>
        <span aria-hidden="true">✦</span>
        {per.tagline}
      </p>

      <h1>{site.name}</h1>

      {
        MODES.map((m) => (
          <div class="bio" data-show={m} data-fade>
            {profiles[m].bio.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        ))
      }

      {
        pro.focus && (
          <ul class="chips" data-show="professional" data-fade aria-label="Focus areas">
            {pro.focus.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        )
      }

      <ul class="links">
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label} ↗</a>
            </li>
          ))
        }
      </ul>

      {
        MODES.map((m) => (
          <button
            type="button"
            class:list={['hint', m]}
            data-show={m}
            data-set-mode={m === 'professional' ? 'personal' : 'professional'}
          >
            {profiles[m].switchHint}
          </button>
        ))
      }
    </div>

    <div class="portrait">
      <figure class="frame-pro" data-show="professional" data-fade>
        <img src={url(pro.photo)} alt={site.name} width="512" height="512" />
        {pro.photoBadge && <figcaption>{pro.photoBadge}</figcaption>}
      </figure>
      <figure class="polaroid" data-show="personal" data-fade>
        <img src={url(per.photo)} alt={`${site.name} at the Golden Gate Bridge`} width="512" height="512" />
        {per.photoCaption && <figcaption>{per.photoCaption}</figcaption>}
      </figure>
    </div>
  </section>

  <!-- ── Toolbox (professional) ───────────────────────── -->
  {
    pro.toolbox && (
      <section class="toolbox" data-show="professional" data-fade aria-label="Toolbox">
        <span class="toolbox-label">Toolbox</span>
        <ul>
          {pro.toolbox.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- ── Writing ──────────────────────────────────────── -->
  {
    MODES.map((m) => {
      const list = posts.filter((p) => p.data.mode === m);
      const [latest, ...rest] = list;
      return (
        <section class="block" data-show={m} data-fade>
          <SectionTitle index="01" title={profiles[m].writingTitle} />
          {latest ? (
            <a class="latest" href={url(`blog/${latest.id}/`)}>
              <span class="kicker">Latest</span>
              <h3>{latest.data.title}</h3>
              {latest.data.description && <p>{latest.data.description}</p>}
              <span class="latest-meta">
                {formatDate(latest.data.date)} · {readingTime(latest.body)} read
                <span class="read">Read →</span>
              </span>
            </a>
          ) : (
            <p class="empty">Nothing here yet. Check back soon.</p>
          )}
          {rest.length > 0 && <PostList posts={rest.slice(0, HOME_LIMIT - 1)} />}
          {list.length > HOME_LIMIT && (
            <a class="more" href={url(`blog/?mode=${m}`)}>
              All {profiles[m].writingTitle.toLowerCase()} →
            </a>
          )}
        </section>
      );
    })
  }

  <!-- ── Projects ─────────────────────────────────────── -->
  <section class="block">
    <SectionTitle index="02" title="Things I’ve built" />
    <div class="grid">
      {projects.map((p, i) => <ProjectCard project={p} index={i + 1} />)}
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 210px;
    gap: 48px;
    align-items: center;
    margin-top: 36px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--accent);
  }

  :global(html[data-mode='professional']) .eyebrow {
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.02em;
  }

  :global(html[data-mode='personal']) .eyebrow {
    font-family: var(--serif);
    font-style: italic;
    font-size: 17px;
    font-weight: 400;
  }

  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  h1 {
    margin: 0;
    font-size: clamp(36px, 7vw, 54px);
    line-height: 1.05;
  }

  :global(html[data-mode='personal']) h1 {
    font-style: italic;
  }

  .bio {
    margin-top: 20px;
    max-width: 58ch;
  }

  .bio p {
    margin: 0 0 12px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 5px 11px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    font-family: var(--sans);
    font-size: 13px;
    color: var(--text);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
  }

  .links a {
    color: var(--accent);
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
  }

  .hint {
    display: inline-block;
    margin-top: 18px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s, transform 0.2s var(--ease);
  }
  .hint:hover {
    color: var(--accent);
  }
  .hint.professional {
    font-family: var(--mono);
    font-size: 12.5px;
  }
  .hint.personal {
    font-family: var(--hand);
    font-size: 21px;
    transform: rotate(-1.5deg);
  }

  /* Professional photo: black & white, offset outline, color on hover */
  .portrait figure {
    margin: 0;
  }

  .frame-pro {
    position: relative;
  }

  .frame-pro::before {
    content: '';
    position: absolute;
    inset: 12px -12px -12px 12px;
    border: 1.5px solid var(--accent);
    border-radius: 22px;
    opacity: 0.55;
  }

  .frame-pro img {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 20px;
    filter: grayscale(1) contrast(1.06);
    transition: filter 0.6s var(--ease);
  }

  .frame-pro:hover img {
    filter: grayscale(0);
  }

  .frame-pro figcaption {
    position: absolute;
    left: 12px;
    bottom: 12px;
    padding: 4px 9px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(6px);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text);
  }

  /* Personal photo: a tilted polaroid */
  .polaroid {
    padding: 10px 10px 0;
    background: #fffdf9;
    border-radius: 3px;
    box-shadow:
      0 18px 40px -12px rgba(90, 45, 15, 0.35),
      0 2px 6px rgba(0, 0, 0, 0.08);
    transform: rotate(3deg);
    transition: transform 0.4s var(--ease);
  }

  .polaroid:hover {
    transform: rotate(0deg) scale(1.03);
  }

  .polaroid img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 1px;
  }

  .polaroid figcaption {
    padding: 6px 0 10px;
    text-align: center;
    font-family: var(--hand);
    font-size: 22px;
    color: #5b4433;
  }

  /* Toolbox strip */
  .toolbox {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-top: 56px;
    padding: 14px 0;
    border-top: 1px dashed var(--line);
    border-bottom: 1px dashed var(--line);
    font-family: var(--mono);
    font-size: 12.5px;
  }

  .toolbox-label {
    flex-shrink: 0;
    color: var(--accent);
  }

  .toolbox ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
  }

  /* Latest post card */
  .block {
    margin-top: 64px;
  }

  .latest {
    position: relative;
    display: block;
    margin-bottom: 8px;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
    text-decoration: none;
    overflow: hidden;
    transition:
      border-color 0.2s,
      transform 0.2s var(--ease);
  }

  .latest::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: var(--accent);
  }

  .latest:hover {
    color: inherit;
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .kicker {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  :global(html[data-mode='personal']) .kicker {
    font-family: var(--hand);
    font-size: 20px;
    letter-spacing: 0;
    text-transform: none;
  }

  .latest h3 {
    margin: 6px 0 6px;
    font-size: 22px;
  }

  .latest p {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 15.5px;
  }

  .latest-meta {
    display: flex;
    gap: 12px;
    font-family: var(--sans);
    font-size: 13px;
    color: var(--muted);
  }

  .read {
    margin-left: auto;
    color: var(--accent);
    font-weight: 500;
  }

  .more {
    display: inline-block;
    margin-top: 14px;
    font-family: var(--sans);
    font-size: 14px;
    color: var(--accent);
    text-decoration: none;
  }

  .empty {
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  @media (max-width: 640px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-top: 8px;
    }
    .portrait {
      order: -1;
      width: 160px;
      margin-left: 6px;
    }
    .toolbox {
      flex-direction: column;
      gap: 8px;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .latest {
      padding: 18px 18px 18px 22px;
    }
  }
</style>
