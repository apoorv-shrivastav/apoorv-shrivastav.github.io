---
import type { CollectionEntry } from 'astro:content';
import { url, readingTime, formatDate } from '../lib/utils';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">Nothing here yet. Check back soon.</p>
  ) : (
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <a href={url(`blog/${post.id}/`)}>
            <span class="title">
              {post.data.title}
              {post.data.featured && (
                <span class="star" title="Favourite">
                  ✦
                </span>
              )}
            </span>
            <span class="meta">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <span class="dot">·</span>
              {readingTime(post.body)}
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .posts a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  li:first-child a {
    border-top: 1px solid var(--line);
  }

  .title {
    font-weight: 500;
  }

  .posts a:hover .title {
    color: var(--accent);
  }

  .star {
    margin-left: 6px;
    color: var(--accent);
    font-size: 0.8em;
  }

  .meta {
    flex-shrink: 0;
    font-family: var(--sans);
    font-size: 13px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .dot {
    margin: 0 6px;
  }

  .empty {
    color: var(--muted);
  }

  @media (max-width: 560px) {
    .posts a {
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
