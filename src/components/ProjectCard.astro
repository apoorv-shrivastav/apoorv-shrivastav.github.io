---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { title, description, href, tag, stack, mode } = Astro.props.project;
const external = /^https?:/.test(href);
---

<a
  class="card"
  href={href}
  data-show={mode}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  <div class="top">
    <h3>{title}</h3>
    {tag && <span class="tag">{tag}</span>}
  </div>
  <p>{description}</p>
  {stack && <span class="stack">{stack}</span>}
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 18px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s var(--ease),
      background-color 0.35s;
  }

  .card:hover {
    color: inherit;
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  h3 {
    margin: 0;
    font-size: 17px;
  }

  .card:hover h3 {
    color: var(--accent);
  }

  .tag {
    flex-shrink: 0;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
  }

  .stack {
    margin-top: auto;
    padding-top: 4px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
</style>
