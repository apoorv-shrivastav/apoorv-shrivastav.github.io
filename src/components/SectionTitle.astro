---
// A Material-style section heading with an optional text-button link on the right.
interface Props {
  title: string;
  link?: { href: string; label: string };
}
const { title, link } = Astro.props;
const external = link ? /^https?:/.test(link.href) : false;
---

<div class="section-head">
  <h2 class="section-title">{title}</h2>
  {
    link && (
      <a
        class="section-link"
        href={link.href}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener' : undefined}
      >
        {link.label}
        <span class="msr" aria-hidden="true">
          {external ? 'open_in_new' : 'arrow_forward'}
        </span>
      </a>
    )
  }
</div>

<style>
  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 0 0 14px;
  }

  .section-title {
    margin: 0;
    font-family: var(--sans);
    font-size: 24px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--text);
  }

  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    margin-right: -12px;
    padding: 8px 12px;
    border-radius: 999px;
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .section-link:hover {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .section-link .msr {
    font-size: 18px;
  }
</style>
